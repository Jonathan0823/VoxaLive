# Admin auth
ADMIN_TOKEN=change-me

# LLM provider keys (optional -- prefer UI management at /secrets)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# VTube Studio auth and connection
VTS_AUTH_TOKEN=
# VTS WebSocket endpoint (can be overridden via admin UI at /settings)
# WSL2 note: if VTube Studio runs on Windows, use the Windows host IP instead of localhost.
# Find host IP in WSL: powershell.exe -Command "Get-NetIPAddress -InterfaceType Ethernet | Select-Object -ExpandProperty IPAddress"
# Example Windows host IP: ws://172.20.176.1:8001
VTS_ENDPOINT=ws://127.0.0.1:8001

# Static file serving (production)
STATIC_DIR=apps/admin-web/dist

# Runtime config persistence
CONFIG_FILE=data/config.runtime.json

# Secret persistence encryption key (production)
# SECRETS_MASTER_KEY=your-production-key-here
SECRETS_FILE=data/secrets.enc

# Frontend
# Leave empty in dev -- Vite proxy handles /api/* and /ws/* -> backend:3000
# Set an absolute URL for production builds served from a different origin
# (e.g., VITE_API_URL=https://api.yourdomain.com)
VITE_API_URL=
