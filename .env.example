# Admin auth
ADMIN_TOKEN=change-me

# LLM provider keys (optional -- prefer UI management at /secrets)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# VTube Studio auth
VTS_AUTH_TOKEN=

# Static file serving (production)
STATIC_DIR=apps/admin-web/dist

# Runtime config persistence
CONFIG_FILE=data/config.runtime.json

# Secret persistence encryption key (production)
# SECRETS_MASTER_KEY=your-production-key-here
SECRETS_FILE=data/secrets.enc

# Frontend
# Leave empty in dev -- Vite proxy handles /api/* and /ws/* -> backend:3000
# Set an absolute URL for production builds served from a different origin
# (e.g., VITE_API_URL=https://api.yourdomain.com)
VITE_API_URL=
